# WordPress-era URLs (the domain ran WordPress before the Next.js site).
# Only posts with a clear topical match on the current site are redirected;
# the rest are left to 404 because no equivalent page exists.
RewriteRule ^14-rrsp-tips-to-optimize-your-account-for-maximum-growth/?$ https://canadianoptimizer.com/blog/rrsp-playbook/ [R=301,L]
RewriteRule ^registered-retirement-savings-plans-rrsps/?$ https://canadianoptimizer.com/blog/rrsp-playbook/ [R=301,L]
