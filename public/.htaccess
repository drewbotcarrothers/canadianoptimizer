RewriteRule ^author/andrew(/page/[0-9]+)?/?$ https://canadianoptimizer.com/about/ [R=301,L]
RewriteRule ^contact-2/?$ https://canadianoptimizer.com/contact/ [R=301,L]

# /path/index.html -> /path/ (the static export serves both; keep one URL).
# THE_REQUEST only matches what the client asked for, so the internal
# DirectoryIndex lookup for /path/ does not loop.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ https://canadianoptimizer.com/%1 [R=301,L]

# Trailing slash before the host rule, so https://www.../path or
# http://.../path reaches https://canadianoptimizer.com/path/ in one hop
# instead of two. Skip real files such as sitemap.xml, robots.txt, rss.xml,
# llms.txt, and images.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://canadianoptimizer.com/$1/ [L,R=301]

# One hop to https://canadianoptimizer.com for every other URL.
# Covers http://canadianoptimizer.com, http://www.canadianoptimizer.com,
# and https://www.canadianoptimizer.com.
# Does not fire for an apex request a TLS-terminating proxy already marked
# as HTTPS, which is what prevents a redirect loop.
# Logic is (A OR B) AND (C OR D):
#   A = host is www
#   B = the connection Apache sees is not HTTPS
#   C = X-Forwarded-Proto is not https
#   D = host is www
RewriteCond %{HTTP_HOST} ^www\.canadianoptimizer\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.canadianoptimizer\.com$ [NC]
RewriteRule ^ https://canadianoptimizer.com%{REQUEST_URI} [L,R=301]
