RewriteRule ^tax-free-savings-account/?$ https://canadianoptimizer.com/blog/tfsa-strategies/ [R=301,L]
RewriteRule ^best-aeroplan-credit-cards/?$ https://canadianoptimizer.com/blog/best-aeroplan-credit-cards-canada/ [R=301,L]
RewriteRule ^how-to-earn-aeroplan-points-faster-than-ever/?$ https://canadianoptimizer.com/blog/aeroplan-points-guide-canada/ [R=301,L]
RewriteRule ^best-cash-back-credit-cards/?$ https://canadianoptimizer.com/blog/best-cash-back-credit-cards-canada/ [R=301,L]
RewriteRule ^best-no-annual-fee-credit-cards/?$ https://canadianoptimizer.com/blog/best-no-annual-fee-credit-cards-canada/ [R=301,L]
