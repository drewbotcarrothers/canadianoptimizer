# Canadian Optimizer canonical host and legacy post URLs.
# Hostinger shared hosting (LiteSpeed/Apache) reads this file from the site root.
# The static export copies public/.htaccess into out/ (see scripts/copy-htaccess.mjs).
# FTP-Deploy-Action excludes **/.git*, **/.git*/**, and **/node_modules/** only.
# Those patterns do not match .htaccess.

RewriteEngine On

# Year-bearing post slugs. These run before the host rule. Each target is
# already https://canadianoptimizer.com, so an old slug on http://, http://www,
# or https://www lands on the yearless URL in a single 301.
RewriteRule ^blog/best-cash-back-credit-cards-canada-2026/?$ https://canadianoptimizer.com/blog/best-cash-back-credit-cards-canada/ [R=301,L]
RewriteRule ^blog/best-travel-rewards-cards-canada-2026/?$ https://canadianoptimizer.com/blog/best-travel-rewards-cards-canada/ [R=301,L]
